    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/auto_continue_stop.py\"",
            "timeout": 45
          }
        ]
      }
    ],
    "PostModelRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/auto_continue_stop.py\"",
            "timeout": 70
          }
        ]
      }
    ]
  }
}
